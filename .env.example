# Copy to .env and fill in your values.
# The detect API reads this from web/.env (web-local, no outside dependency).

# --- LLM channel 1 (STG AI server, default) ---
LLM_1_API_KEY=sk-your-key-here
# LLM_1_BASE_URL=https://llm.stgaiserver.com/v1
# LLM_1_MODEL=/models/qwen3.6-35b-a3b.gguf

# --- LLM channel 2 (Aliyun DashScope, optional) ---
# LLM_2_API_KEY=sk-your-key-here
# LLM_2_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_2_MODEL=qwen3.8-flash

# --- Failover ---
# Off by default: channels are switched manually in the UI. Set to 1 to let a
# slow/timing-out call automatically fail over to the other channel.
# LLM_FAILOVER=0

# --- App PIN ---
# Server-side PIN required to open the page (checked in /api/verify-pin;
# the UI shows a PIN pop-up on every page refresh).
# APP_PIN=your-pin-here

# --- Thinking off (per-channel extra request body, JSON) ---
# Default sends {"enable_reasoning": false, "enable_thinking": false} — the
# STG server honors enable_reasoning, DashScope honors enable_thinking, and
# each server ignores the field it does not know. Override per channel if
# needed (empty object sends nothing extra):
# LLM_1_EXTRA_BODY={"enable_reasoning": false}
# LLM_2_EXTRA_BODY={"enable_thinking": false}

# --- Legacy single-channel variables (still supported) ---
# LLM_API_KEY=sk-your-key-here
# LLM_BASE_URL=https://llm.stgaiserver.com/v1
# LLM_MODEL=/models/qwen3.6-35b-a3b.gguf

# REQUIRED to match the basePath in next.config.ts, or the UI's upload/detect
# buttons call unprefixed /api/* URLs and 404:
NEXT_PUBLIC_BASE_PATH=/cisco-demo

# --- Limits & retention (public demo hygiene) ---
# Max NEW detection runs per browser session (refreshing the page resets it).
# MAX_RUNS_PER_SESSION=20
# How long run artefacts and uploaded drawings are kept.
# RUN_TTL_MS=86400000
# UPLOAD_TTL_MS=86400000
